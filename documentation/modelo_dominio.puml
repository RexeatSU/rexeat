@startuml ModeloDominioRexeat
skinparam style strictuml
skinparam DefaultFontName "Helvetica"
skinparam class {
    BackgroundColor White
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
}

class Dueño {
    nombre: String
    correo: String
}

class Restaurante {
    nombre: String
    direccion: String
    telefono: String
}

class Manager {
    nombre: String
    correo: String
}

class Carta {
    nombre: String
    activa: Boolean
}

class Menú {
    activo: Boolean
}

class SecciónMenú {
    nombre: String
}

class OpcionMenú {
    suplemento: Decimal
}

class Categoría {
    nombre: String
}

abstract class Producto {
    nombre: String
    precio: Decimal
    stock: Boolean
    disponible: Boolean
}

class Plato {
    descripcion: String
    imagen: String
}

class Bebida {
    descripcion: String
    alcohol: Boolean
    marca: String
    denominacionOrigen: String
}

class Cantidad <<Value Object>> {
    defecto: Integer
    minima: Integer
    maxima: Integer
    unidadMedida: String
}

class Ingrediente {
    nombre: String
    cantidad: Cantidad
    suplementoExtra: Decimal
}

enum Alergeno {
    GLUTEN
    LACTOSA
    FRUTOS_SECOS
    PESCADO
    MARISCO
    HUEVO
    SOJA
    SULFITOS
}

class Comensal {
    idiomaPreferido: String
}

' Herencia de Productos (Patrón Composite)
Producto <|-- Plato
Producto <|-- Bebida
Producto <|-- Menú

' Relaciones principales del Restaurante y Personas
Dueño "1" -- "1..*" Restaurante : posee >
Restaurante "1" -- "0..*" Manager : emplea >
Restaurante "1" -- "1..*" Carta : ofrece >

' Estructura de la Carta
Carta "1" -- "0..*" Menú : contiene >
Carta "1" -- "0..*" Categoría : contiene >
Carta "1" -- "0..*" Producto : contiene >

' Relaciones de Categorías (Etiquetas)
Categoría "0..*" -- "0..*" Producto : clasifica >

' Estructura interna del Menú (Opciones y Secciones)
Menú "1" -- "1..*" SecciónMenú : contiene >
SecciónMenú "1" -- "1..*" OpcionMenú : ofrece >
OpcionMenú "1" -- "1" Producto : asocia >

' Composición de Plato
Plato "1" -- "1..*" Ingrediente : contiene >
Ingrediente "1" *-- "1" Cantidad : contiene >

' Relaciones del Comensal
Comensal "0..*" -- "1" Restaurante : accede a la web de >
Comensal "0..*" -- "1..*" Carta : ve >
Comensal "0..*" -- "1..*" Menú : consulta >

' Gestión de Cartas y Menús
Manager "1..*" -- "1..*" Carta : gestiona >

' Relación de Alérgenos
Producto "0..*" -- "0..*" Alergeno : / contiene >
Ingrediente "0..*" -- "0..*" Alergeno : contiene >

note bottom of Producto
  Los alérgenos de un Plato se derivan de sus Ingredientes.
  Los alérgenos de un Menú se derivan en cascada de sus Productos.
end note

note bottom of Menú
  El Menú se considera "Agotado" (sin stock o no disponible) si:
  - Alguna de sus SecciónMenú se queda sin al menos una OpcionMenú disponible en stock.
end note

@endum

