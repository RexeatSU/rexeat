@startuml DiagramaObjetosMcDonalds
skinparam style strictuml
skinparam DefaultFontName "Helvetica"
skinparam object {
    BackgroundColor White
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
}

' Restaurante
object "mcdonalds : Restaurante" as r {
    nombre = "McDonald's"
    direccion = "Gran Vía 24, Madrid"
    telefono = "911234567"
}

' Carta
object "cartaPrincipal : Carta" as c {
    nombre = "Carta Principal"
    activa = true
}

' Menú Familiar (Menú principal)
object "menuFamiliar : Menú" as mf {
    nombre = "Menú Compartir Familiar"
    precio = 18.50
    stock = true
    disponible = true
    activo = true
}

' Sección 1 del Menú Familiar: Menús Individuales
object "secMenues : SecciónMenú" as sm1 {
    nombre = "Menú Individual Incluido"
}

' Opción de Menú para el Menú Familiar que apunta al Menú Simple
object "opcMenuSimple : OpcionMenú" as opc_ms {
    suplemento = 0.00
}

' Menú Simple (Hamburguesa con queso) que actúa como Producto
object "menuSimple : Menú" as ms {
    nombre = "McMenú Simple Hamburguesa"
    precio = 7.50
    stock = true
    disponible = true
    activo = true
}

' Sección del Menú Simple: Hamburguesas
object "secHambSimple : SecciónMenú" as sm_h {
    nombre = "Elige tu Hamburguesa"
}

' Opción de Hamburguesa con Queso
object "opcHambQueso : OpcionMenú" as opc_hq {
    suplemento = 0.00
}

object "hamburguesaQueso : Plato" as hq {
    nombre = "Hamburguesa con Queso"
    precio = 2.50
    stock = true
    disponible = true
    descripcion = "Carne de vacuno 100%, queso fundido, pepinillo, cebolla, mostaza y kétchup."
    imagen = "hamburguesa_queso.png"
}

' Ingredientes de la Hamburguesa
' Cantidades (Value Objects)
object "cantCarne : Cantidad" as c_carne {
    defecto = 1
    minima = 1
    maxima = 3
    unidadMedida = "unidades"
}

object "cantQueso : Cantidad" as c_queso {
    defecto = 1
    minima = 0
    maxima = 3
    unidadMedida = "lonchas"
}

object "cantPepinillo : Cantidad" as c_pepinillo {
    defecto = 2
    minima = 0
    maxima = 4
    unidadMedida = "rodajas"
}

object "cantHuevo : Cantidad" as c_huevo {
    defecto = 0
    minima = 0
    maxima = 2
    unidadMedida = "unidades"
}

object "cantBeicon : Cantidad" as c_beicon {
    defecto = 2
    minima = 0
    maxima = 4
    unidadMedida = "lonchas"
}

' Ingredientes de la Hamburguesa
object "ingCarne : Ingrediente" as i_carne {
    nombre = "Carne 100% Vacuno"
    suplementoExtra = 1.50
}

object "ingQueso : Ingrediente" as i_queso {
    nombre = "Queso Cheddar"
    suplementoExtra = 0.50
}

object "ingPepinillo : Ingrediente" as i_pepinillo {
    nombre = "Pepinillo"
    suplementoExtra = 0.00
}

object "ingHuevoExtra : Ingrediente" as i_huevo {
    nombre = "Huevo Frito"
    suplementoExtra = 1.00
}

object "ingBeicon : Ingrediente" as i_beicon {
    nombre = "Beicon"
    suplementoExtra = 0.50
}

' Sección del Menú Simple: Patatas
object "secPatatasSimple : SecciónMenú" as sm_p {
    nombre = "Elige tus Patatas"
}

' Opción de Patatas Fritas Finas
object "opcPatatasFinas : OpcionMenú" as opc_pf {
    suplemento = 0.00
}

object "patatasFinas : Plato" as pf {
    nombre = "Patatas Fritas Finas"
    precio = 2.20
    stock = true
    disponible = true
    descripcion = "Patatas fritas cortadas finas, crujientes y en su punto de sal."
    imagen = "patatas_finas.png"
}

' Opción de Patatas Deluxe con Suplemento
object "opcPatatasDeluxe : OpcionMenú" as opc_pd {
    suplemento = 0.50
}

object "patatasDeluxe : Plato" as pd {
    nombre = "Patatas Fritas Deluxe"
    precio = 2.70
    stock = true
    disponible = true
    descripcion = "Patatas fritas gajo sazonadas con especias y acompañadas de salsa deluxe."
    imagen = "patatas_deluxe.png"
}

' Sección 2 del Menú Familiar: Bebida Familiar
object "secBebidaFam : SecciónMenú" as sm2 {
    nombre = "Elige tu Bebida Familiar"
}

' Opción de Bebida Grande
object "opcRefresco : OpcionMenú" as opc_ref {
    suplemento = 0.00
}

object "cocaCola : Bebida" as cc {
    nombre = "Coca-Cola Zero Grande"
    precio = 2.90
    stock = true
    disponible = true
    descripcion = "Refresco de extractos sin azúcar."
    alcohol = false
    marca = "Coca-Cola"
    denominacionOrigen = ""
}

' Categorías (Etiquetas)
object "catHamburguesas : Categoría" as cat_h {
    nombre = "Hamburguesas"
}

object "catPatatas : Categoría" as cat_p {
    nombre = "Patatas Fritas"
}

object "catBebidas : Categoría" as cat_b {
    nombre = "Bebidas"
}

' Relaciones del Restaurante y la Carta
r "1" -- "1" c : ofrece
c "1" -- "*" mf : contiene
c "1" -- "*" ms : contiene
c "1" -- "*" hq : contiene
c "1" -- "*" pf : contiene
c "1" -- "*" pd : contiene
c "1" -- "*" cc : contiene

' Estructura del Menú Familiar (Menú principal)
mf "1" -- "*" sm1 : contiene
sm1 "1" -- "*" opc_ms : ofrece
opc_ms "1" -- "1" ms : asocia

mf "1" -- "*" sm2 : contiene
sm2 "1" -- "*" opc_ref : ofrece
opc_ref "1" -- "1" cc : asocia

' Estructura del Menú Simple (que es un Producto)
ms "1" -- "*" sm_h : contiene
sm_h "1" -- "*" opc_hq : ofrece
opc_hq "1" -- "1" hq : asocia

ms "1" -- "*" sm_p : contiene
sm_p "1" -- "*" opc_pf : ofrece
opc_pf "1" -- "1" pf : asocia
sm_p "1" -- "*" opc_pd : ofrece
opc_pd "1" -- "1" pd : asocia

' Composición de Plato (Ingredientes estándar y extras opcionales)
hq "1" -- "*" i_carne : contiene
hq "1" -- "*" i_queso : contiene
hq "1" -- "*" i_pepinillo : contiene
hq "1" -- "*" i_huevo : contiene
hq "1" -- "*" i_beicon : contiene

' Composición de Ingredientes (Value Objects de Cantidad)
i_carne "1" *-- "1" c_carne : contiene
i_queso "1" *-- "1" c_queso : contiene
i_pepinillo "1" *-- "1" c_pepinillo : contiene
i_huevo "1" *-- "1" c_huevo : contiene
i_beicon "1" *-- "1" c_beicon : contiene

' Clasificación por Categorías (Etiquetas Muchos a Muchos)
cat_h "0..*" -- "0..*" hq : clasifica
cat_p "0..*" -- "0..*" pf : clasifica
cat_p "0..*" -- "0..*" pd : clasifica
cat_b "0..*" -- "0..*" cc : clasifica

@endum
